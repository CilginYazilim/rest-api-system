# =====================================================================
#  ORTAM DEĞİŞKENLERİ – ÖRNEK DOSYA
#  Bu dosyayı ".env" adıyla kopyalayın ve kendi değerlerinizi yazın.
#      Windows : copy .env.example .env
#      Linux   : cp .env.example .env
#
#  ".env" dosyası .gitignore içindedir; asla depoya gönderilmez.
#  Böylece veritabanı şifreniz GitHub'a sızmaz.
# =====================================================================

# --- Uygulama --------------------------------------------------------
# APP_DEBUG BİLEREK KAPALI (yorumda) GELİYOR.
#
# Satır yokken uygulama kendi karar verir: yerelde (localhost, *.test,
# *.local) açık, gerçek bir alan adında kapalı olur. Bu, bu dosyayı
# olduğu gibi kopyalayıp canlıya çıkan birini korur — açık bir hata
# yığını dosya yollarınızı, tablo adlarınızı ve sorgularınızı sızdırır.
#
# Yerelde zaten açıktır; elle açmanız gerekmez. Yalnızca kararı
# ZORLAMAK istiyorsanız aşağıdaki satırı etkinleştirin.
# APP_DEBUG=true

# Boş bırakılırsa adres otomatik tespit edilir.
APP_URL=

# Temiz adres:  true  → /login      (önerilen, .htaccess ile gelir)
#               false → /index.php?r=login
# Apache'de mod_rewrite kapalıysa veya Nginx kullanıyorsanız ve
# yönlendirme kuralını tanımlamadıysanız false yapın.
APP_PRETTY_URLS=true

# --- Veritabanı ------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cy_rest_api
DB_USER=root
DB_PASS=
